{
  "name": "EC-eduflow-v3-firebase",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:app": "next dev",
    "dev:local": "node scripts/start-local-emulator.mjs --exec",
    "emulators:start": "node scripts/start-local-emulator.mjs",
    "db:local:seed": "NEXT_PUBLIC_APP_ENV=local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-local-firestore.mjs",
    "db:local:seed-partnerships": "NEXT_PUBLIC_APP_ENV=local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-local-partnerships.mjs",
    "db:local:seed-follow-ups": "NEXT_PUBLIC_APP_ENV=local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed-local-follow-ups.mjs",
    "db:local:reset": "NEXT_PUBLIC_APP_ENV=local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/reset-local-firestore.mjs && npm run db:local:seed",
    "db:local:export": "mkdir -p .firebase && firebase emulators:export .firebase/emulator-data --project demo-eduflow-local --force",
    "db:migrate:local:dry-run": "NEXT_PUBLIC_APP_ENV=local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/firestore-migrate.mjs",
    "db:migrate:local": "NEXT_PUBLIC_APP_ENV=local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/firestore-migrate.mjs --apply",
    "db:migrate:production:dry-run": "node scripts/firestore-migrate.mjs --production",
    "db:migrate:production": "node scripts/firestore-migrate.mjs --production --apply",
    "db:recover-primary-contacts:local": "NEXT_PUBLIC_APP_ENV=local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/recover-primary-contacts.mjs",
    "db:recover-primary-contacts:production": "node scripts/recover-primary-contacts.mjs --production",
    "db:sync-school-programme-calendar:dry-run": "node scripts/sync-school-programme-calendar.mjs",
    "db:sync-school-programme-calendar": "node scripts/sync-school-programme-calendar.mjs --apply",
    "db:seed-production-school-programme:dry-run": "node scripts/seed-production-school-programme.mjs",
    "db:seed-production-school-programme": "node scripts/seed-production-school-programme.mjs --apply",
    "firebase:deploy:production": "firebase deploy --only firestore:rules,firestore:indexes --project production",
    "clean-dev": "rm -rf .next && npm run dev:local",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.8.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.3.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.5.12",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-calendar-timeline": "^0.30.0-beta.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^6.4.17",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/tailwindcss": "^3.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.27",
    "eslint": "9.39.4",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.8",
    "server-only": "^0.0.1",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
