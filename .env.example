# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Auth.js
AUTH_SECRET= # Run `npx auth secret` to generate

# Runtime mode. Use "local" on developer machines and "production" in Vercel.
NEXT_PUBLIC_APP_ENV=local

# Firebase production values belong in Vercel, not in local development files.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_BACKUP_BUCKET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron
CRON_SECRET=
# Google administrative refresh token (Requires Contacts and Calendar scopes)
GOOGLE_REFRESH_TOKEN=

# Email (SMTP + IMAP for Sent folder)
SMTP_HOST=mail.educompass.in
SMTP_PORT=587
SMTP_USER=your-email@educompass.in
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=EduCompass
IMAP_HOST=mail.educompass.in
IMAP_PORT=993
IMAP_SENT_FOLDER=INBOX.ECRM-sent
